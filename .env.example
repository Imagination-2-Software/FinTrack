# FinTrack - Supabase Environment Configuration
# Copy this file to .env.local and populate with your project credentials from Supabase Dashboard

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Server-only API configuration. Never use a VITE_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
